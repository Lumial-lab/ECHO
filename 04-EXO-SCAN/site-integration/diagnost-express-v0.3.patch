+    if (!option || option.points === null || option.points === undefined) {
+      unknownCount += 1;
+      if (value === 'other') otherCount += 1;
+      continue;
+    }
+    scoreValues[question.score].push(option.points);
+  }
+
+  const scores = {
+    opportunity: average(scoreValues.opportunity),
+    readiness: average(scoreValues.readiness),
+    cooperation: average(scoreValues.cooperation),
+  };
+
