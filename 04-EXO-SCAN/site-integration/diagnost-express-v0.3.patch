@@ -0,0 +1,367 @@
+---
+interface Props { contactEmail: string }
+const { contactEmail } = Astro.props;
+---
+
+<section class="diagnost" data-diagnost data-contact-email={contactEmail}>
+  <header class="diagnost-hero">
+    <p class="diagnost-hero__kicker">ЕХО · ПОПЕРЕДНЯ ДІАГНОСТИКА</p>
+    <h1 class="diagnost-hero__title">ЕХО Діагност</h1>
+    <p class="diagnost-hero__lede">
+      Знайдіть перший процес, у якому АІ може дати вимірюваний результат,
+      і побачте, що потрібно підготувати для безпечного пілота.
+    </p>
+  </header>
+
+  <div class="diagnost-trust" aria-label="Умови проходження">
+    <span>12 коротких питань</span>
+    <span>без реєстрації</span>
+    <span>відповіді лишаються у браузері</span>
+  </div>
+
+  <section class="diagnost-intro" data-intro>
+    <div>
+      <p class="diagnost-eyebrow">Що ви отримаєте</p>
+      <h2>Один предметний наступний крок</h2>
+      <p>
+        Діагност розділяє потенціал користі, готовність процесів і здатність
+        провести пілот. Це самооцінка для першої розмови, не аудит підприємства.
+      </p>
+    </div>
+    <div class="diagnost-intro__actions">
+      <button class="diagnost-button diagnost-button--primary" type="button" data-start>
+        Почати діагностику
+      </button>
+      <button class="diagnost-link-button" type="button" data-clear hidden>
+        Скинути збережений прогрес
+      </button>
+    </div>
+  </section>
+
+  <form class="diagnost-tool" data-tool hidden novalidate>
+    <div class="diagnost-progress">
+      <div class="diagnost-progress__meta">
+        <span data-group>Контекст</span>
+        <span data-progress-label>Крок 1 із 12</span>
+      </div>
+      <div class="diagnost-progress__track" role="progressbar" aria-valuemin="1" aria-valuemax="12" aria-valuenow="1" data-progress>
+        <span data-progress-bar></span>
+      </div>
+    </div>
+
+    <fieldset class="diagnost-question">
+      <legend class="diagnost-question__title" data-question tabindex="-1"></legend>
+      <p class="diagnost-question__hint" id="diagnost-hint" data-hint></p>
+      <div class="diagnost-options" data-options aria-describedby="diagnost-hint"></div>
+      <label class="diagnost-own" data-own-wrap hidden>
+        <span>Коротко уточніть свою відповідь</span>
+        <textarea data-own rows="3" maxlength="500" placeholder="Необов’язкове уточнення для майбутньої консультації"></textarea>
+      </label>
+      <p class="diagnost-error" data-error role="alert" hidden>Оберіть один варіант, щоб продовжити.</p>
+    </fieldset>
+
+    <div class="diagnost-navigation">
+      <button class="diagnost-button diagnost-button--secondary" type="button" data-back>Назад</button>
+      <button class="diagnost-button diagnost-button--primary" type="submit" data-next>Далі</button>
+    </div>
+  </form>
+
+  <section class="diagnost-result" data-result hidden aria-live="polite">
+    <header class="diagnost-result__header">
+      <p class="diagnost-eyebrow">Попередній результат</p>
+      <h2 data-result-title></h2>
+      <p data-result-summary></p>
+    </header>
+
+    <div class="diagnost-indicators" data-indicators></div>
+    <p class="diagnost-evidence" data-evidence></p>
+
+    <section class="diagnost-route" aria-labelledby="route-title">
+      <div>
+        <p class="diagnost-eyebrow">Перший крок</p>
+        <h3 id="route-title" data-first-step-title></h3>
+        <p data-first-step></p>
+      </div>
+      <div>
+        <p class="diagnost-eyebrow">Перевірка користі</p>
+        <h3 data-pilot-title></h3>
+        <p data-pilot></p>
+        <p class="diagnost-metric"><strong>Вимірюємо:</strong> <span data-metric></span></p>
+      </div>
+    </section>
+
+    <section class="diagnost-signals" aria-labelledby="signals-title">
+      <h3 id="signals-title">На чому тримається висновок</h3>
+      <ul data-signals></ul>
+    </section>
+
+    <section class="diagnost-packages" aria-labelledby="packages-title">
+      <div class="diagnost-packages__heading">
+        <p class="diagnost-eyebrow">Три масштаби співпраці</p>
+        <h3 id="packages-title">Рекомендований формат позначено нижче</h3>
+      </div>
+      <div class="diagnost-packages__list" data-packages></div>
+    </section>
+
+    <div class="diagnost-result__actions">
+      <a class="diagnost-button diagnost-button--primary" data-contact href="/kontakty/">Обговорити результат</a>
+      <button class="diagnost-button diagnost-button--secondary" type="button" data-print>Зберегти як PDF</button>
+      <button class="diagnost-link-button" type="button" data-restart>Пройти ще раз</button>
+    </div>
+
+    <p class="diagnost-result__code">Код результату: <strong data-result-code></strong></p>
+    <p class="diagnost-disclaimer">
+      Результат сформовано лише з ваших відповідей. Документи, сайт і фактичні
+      процеси не перевірялися. Остаточна пропозиція визначається після короткої розмови.
+    </p>
+  </section>
+
+  <noscript>
+    <p class="diagnost-noscript">
+      Для інтерактивного проходження потрібен JavaScript. Діагност не передає
+      відповіді назовні й працює без реєстрації.
+    </p>
+  </noscript>
+
+  <p class="visually-hidden" aria-live="polite" data-announcer></p>
+</section>
+
+<script>
+  import { PACKAGES, QUESTIONS, evaluateDiagnost } from '../lib/diagnost-express.mjs';
+
+  const root = document.querySelector('[data-diagnost]');
+  if (root) {
+    const storageKey = 'exo-diagnost-express-v0.3';
+    const intro = root.querySelector('[data-intro]');
+    const tool = root.querySelector('[data-tool]');
+    const resultView = root.querySelector('[data-result]');
+    const startButton = root.querySelector('[data-start]');
+    const clearButton = root.querySelector('[data-clear]');
+    const backButton = root.querySelector('[data-back]');
+    const nextButton = root.querySelector('[data-next]');
+    const restartButton = root.querySelector('[data-restart]');
+    const printButton = root.querySelector('[data-print]');
+    const optionsContainer = root.querySelector('[data-options]');
+    const ownWrap = root.querySelector('[data-own-wrap]');
+    const ownInput = root.querySelector('[data-own]');
+    const error = root.querySelector('[data-error]');
+    const announcer = root.querySelector('[data-announcer]');
+    const contactEmail = root.getAttribute('data-contact-email') || '';
+
+    let currentIndex = 0;
+    let answers = {};
+    let comments = {};
+
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+    const scrollToTool = (element) => element?.scrollIntoView({ behavior: reducedMotion ? 'auto' : 'smooth', block: 'start' });
+
+    function readSaved() {
+      try {
+        const saved = JSON.parse(sessionStorage.getItem(storageKey) || 'null');
+        if (!saved || typeof saved !== 'object') return false;
+        answers = saved.answers && typeof saved.answers === 'object' ? saved.answers : {};
+        comments = saved.comments && typeof saved.comments === 'object' ? saved.comments : {};
+        currentIndex = Number.isInteger(saved.currentIndex) ? Math.min(Math.max(saved.currentIndex, 0), QUESTIONS.length - 1) : 0;
+        return Object.keys(answers).length > 0;
+      } catch {
+        sessionStorage.removeItem(storageKey);
+        return false;
+      }
+    }
+
+    function saveProgress() {
+      sessionStorage.setItem(storageKey, JSON.stringify({ answers, comments, currentIndex }));
+    }
+
+    function clearProgress() {
+      sessionStorage.removeItem(storageKey);
+      answers = {};
+      comments = {};
+      currentIndex = 0;
+    }
+
+    function setView(view) {
+      intro.hidden = view !== 'intro';
+      tool.hidden = view !== 'tool';
+      resultView.hidden = view !== 'result';
+    }
+
+    function renderQuestion() {
+      const question = QUESTIONS[currentIndex];
+      root.querySelector('[data-group]').textContent = question.group;
+      root.querySelector('[data-progress-label]').textContent = `Крок ${currentIndex + 1} із ${QUESTIONS.length}`;
+      root.querySelector('[data-question]').textContent = question.text;
+      root.querySelector('[data-hint]').textContent = question.hint || '';
+      root.querySelector('[data-hint]').hidden = !question.hint;
+
+      const progress = root.querySelector('[data-progress]');
+      progress.setAttribute('aria-valuemax', String(QUESTIONS.length));
+      progress.setAttribute('aria-valuenow', String(currentIndex + 1));
+      root.querySelector('[data-progress-bar]').style.width = `${((currentIndex + 1) / QUESTIONS.length) * 100}%`;
+
+      optionsContainer.replaceChildren();
+      for (const option of question.options) {
+        const label = document.createElement('label');
+        label.className = 'diagnost-option';
+
+        const input = document.createElement('input');
+        input.type = 'radio';
+        input.name = question.id;
+        input.value = option.value;
+        input.checked = answers[question.id] === option.value;
+
+        const marker = document.createElement('span');
+        marker.className = 'diagnost-option__marker';
+        marker.setAttribute('aria-hidden', 'true');
+
+        const text = document.createElement('span');
+        text.className = 'diagnost-option__text';
+        text.textContent = option.label;
+
+        input.addEventListener('change', () => {
+          answers[question.id] = option.value;
+          error.hidden = true;
+          renderOwnAnswer(question);
+          saveProgress();
+        });
+
+        label.append(input, marker, text);
+        optionsContainer.append(label);
+      }
+
+      renderOwnAnswer(question);
+      backButton.disabled = currentIndex === 0;
+      nextButton.textContent = currentIndex === QUESTIONS.length - 1 ? 'Побачити результат' : 'Далі';
+      error.hidden = true;
+      announcer.textContent = `Крок ${currentIndex + 1}. ${question.text}`;
+      requestAnimationFrame(() => root.querySelector('[data-question]')?.focus?.());
+    }
+
+    function renderOwnAnswer(question) {
+      const isOther = answers[question.id] === 'other';
+      ownWrap.hidden = !isOther;
+      ownInput.value = comments[question.id] || '';
+      ownInput.oninput = () => {
+        comments[question.id] = ownInput.value.slice(0, 500);
+        saveProgress();
+      };
+    }
+
+    function start() {
+      setView('tool');
+      renderQuestion();
+      scrollToTool(tool);
+    }
+
+    function renderResult() {
+      const result = evaluateDiagnost(answers);
+      setView('result');
+      sessionStorage.removeItem(storageKey);
+
+      root.querySelector('[data-result-title]').textContent = result.title;
+      root.querySelector('[data-result-summary]').textContent = result.summary;
+      root.querySelector('[data-first-step-title]').textContent = 'Що робити зараз';
+      root.querySelector('[data-first-step]').textContent = result.firstStep;
+      root.querySelector('[data-pilot-title]').textContent = result.pilot.label;
+      root.querySelector('[data-pilot]').textContent = result.pilot.pilot;
+      root.querySelector('[data-metric]').textContent = result.pilot.metric;
+      root.querySelector('[data-result-code]').textContent = result.resultCode;
+
+      const indicators = root.querySelector('[data-indicators]');
+      indicators.replaceChildren();
+      for (const item of result.indicators) {
+        const row = document.createElement('div');
+        row.className = `diagnost-indicator diagnost-indicator--${item.tone}`;
+        const width = item.tone === 'unknown' ? 0 : Math.max(10, (item.value / 4) * 100);
+        row.innerHTML = `
+          <div class="diagnost-indicator__copy"><span>${item.axis}</span><strong>${item.label}</strong></div>
+          <div class="diagnost-indicator__track" aria-hidden="true"><span style="width:${width}%"></span></div>
+        `;
+        indicators.append(row);
+      }
+
+      root.querySelector('[data-evidence]').textContent = result.evidence.unknown
+        ? `Підстава: ${result.evidence.known} із ${result.evidence.total} змістовних відповідей; ${result.evidence.unknown} потребують уточнення.`
+        : `Підстава: усі ${result.evidence.total} змістовних питань мають визначені відповіді.`;
+
+      const signals = root.querySelector('[data-signals]');
+      signals.replaceChildren();
+      for (const signal of result.signals) {
+        const item = document.createElement('li');
+        item.textContent = signal;
+        signals.append(item);
+      }
+
+      const packages = root.querySelector('[data-packages]');
+      packages.replaceChildren();
+      for (const item of PACKAGES) {
+        const article = document.createElement('article');
+        article.className = 'diagnost-package';
+        if (item.id === result.recommendedPackage) {
+          article.classList.add('diagnost-package--recommended');
+          article.setAttribute('aria-label', `${item.name}. Рекомендований формат`);
+        }
+        const badge = item.id === result.recommendedPackage ? '<span>Рекомендовано</span>' : '';
+        article.innerHTML = `${badge}<h4>${item.name}</h4><p>${item.description}</p>`;
+        packages.append(article);
+      }
+
+      const subject = encodeURIComponent(`ЕХО Діагност · ${result.resultCode}`);
+      const body = encodeURIComponent(`Добрий день! Я пройшов/ла ЕХО Діагност.\n\nКод результату: ${result.resultCode}\nРекомендований напрямок: ${result.title}\n\nХочу обговорити можливий перший крок.`);
+      const contact = root.querySelector('[data-contact]');
+      contact.href = contactEmail ? `mailto:${contactEmail}?subject=${subject}&body=${body}` : '/kontakty/';
+
+      announcer.textContent = `Діагностику завершено. ${result.title}`;
+      scrollToTool(resultView);
+    }
+
+    const hasSaved = readSaved();
+    if (hasSaved) {
+      startButton.textContent = 'Продовжити діагностику';
+      clearButton.hidden = false;
+    }
+
+    startButton.addEventListener('click', start);
+    clearButton.addEventListener('click', () => {
+      clearProgress();
+      startButton.textContent = 'Почати діагностику';
+      clearButton.hidden = true;
+    });
+
+    tool.addEventListener('submit', (event) => {
+      event.preventDefault();
+      const question = QUESTIONS[currentIndex];
+      if (!answers[question.id]) {
+        error.hidden = false;
+        optionsContainer.querySelector('input')?.focus();
+        return;
+      }
+      if (currentIndex < QUESTIONS.length - 1) {
+        currentIndex += 1;
+        saveProgress();
+        renderQuestion();
+        scrollToTool(tool);
+      } else {
+        renderResult();
+      }
+    });
+
+    backButton.addEventListener('click', () => {
+      if (currentIndex === 0) return;
+      currentIndex -= 1;
+      saveProgress();
+      renderQuestion();
+      scrollToTool(tool);
+    });
+
+    restartButton.addEventListener('click', () => {
+      clearProgress();
+      setView('intro');
+      startButton.textContent = 'Почати діагностику';
+      clearButton.hidden = true;
+      scrollToTool(intro);
+    });
+
+    printButton.addEventListener('click', () => window.print());
+  }
+</script>
