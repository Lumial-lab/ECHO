+  if (evidenceRatio < 0.67) {
+    route = 'discovery';
+  } else if (contradictions.length > 0 || (scores.readiness ?? 0) < 1.75 || (scores.cooperation ?? 0) < 1.4) {
+    route = 'foundation';
+  } else if ((scores.opportunity ?? 0) < 1.6) {
+    route = 'discovery';
+  } else if ((scores.readiness ?? 0) >= 3.45 && (scores.cooperation ?? 0) >= 3.35 && (scores.opportunity ?? 0) >= 3.2) {
+    route = 'systemic';
+  } else if ((scores.readiness ?? 0) >= 2.65 && (scores.cooperation ?? 0) >= 2.4) {
+    route = 'connected';
+  }
+
+  const routeInfo = ROUTES[route];
+  const goalPilot = GOAL_PILOTS[answers.goal] ?? GOAL_PILOTS.unknown;
+  const signals = [];
+
+  if ((scores.opportunity ?? 0) >= 3) signals.push('Є повторюваний процес із помітною вартістю часу, помилок або затримок.');
+  if ((scores.readiness ?? 0) >= 3) signals.push('Дані й робочі правила вже дозволяють перевіряти АІ на обмеженому контурі.');
+  if ((scores.cooperation ?? 0) >= 3) signals.push('Є передумови для відповідального пілота з визначеними доступами й відповідальними.');
+  if ((scores.readiness ?? 4) < 1.75) signals.push('Першу користь дасть упорядкування процесу й даних, а не складна автоматизація.');
+  if ((scores.cooperation ?? 4) < 1.75) signals.push('До пілота потрібно визначити відповідального, межі даних і спосіб перевірки результатів.');
+  if (otherCount > 0) signals.push('Власні відповіді варто розібрати на короткій консультації, бо вони не зводяться до типового сценарію.');
+  signals.push(...contradictions);
+
+  return {
+    scoringVersion: SCORING_VERSION,
+    methodologyStatus: 'PRELIMINARY_SELF_ASSESSMENT',
+    route,
+    resultCode: `EXO-${route.toUpperCase()}-${SCORING_VERSION}`,
+    title: routeInfo.title,
+    summary: routeInfo.summary,
+    firstStep: routeInfo.firstStep,
+    pilot: goalPilot,
+    recommendedPackage: routeInfo.recommendedPackage,
+    scores,
+    indicators: [
+      indicator(scores.opportunity, 'Потенціал користі'),
+      indicator(scores.readiness, 'Готовність процесів і даних'),
+      indicator(scores.cooperation, 'Готовність до безпечного пілота'),
+    ],
+    evidence: {
+      known: evidenceKnown,
+      total: SCORE_QUESTIONS.length,
+      percent: Math.round(evidenceRatio * 100),
+      unknown: unknownCount,
+    },
+    contradictions,
+    signals,
+  };
+}
