diff --git a/tests/diagnost-express.test.mjs b/tests/diagnost-express.test.mjs
new file mode 100644
index 0000000..369defc
--- /dev/null
+++ b/tests/diagnost-express.test.mjs
@@ -0,0 +1,93 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+
+import { evaluateDiagnost, SCORING_VERSION } from '../src/lib/diagnost-express.mjs';
+
+const readySmall = {
+  goal: 'save_time',
+  sector: 'professional',
+  team_size: 'micro',
+  repeated_work: 'daily_heavy',
+  process_cost: 'hours',
+  process_data: 'managed',
+  task_tools: 'system',
+  process_visibility: 'documented',
+  knowledge_access: 'shared_base',
+  external_cycle: 'assigned',
+  governance: 'defined',
+  change_capacity: 'pilot_ready',
+};
+
+test('same answers always return the same result', () => {
+  assert.deepEqual(evaluateDiagnost(readySmall), evaluateDiagnost({ ...readySmall }));
+  assert.equal(evaluateDiagnost(readySmall).scoringVersion, SCORING_VERSION);
+});
+
+test('company size and sector do not inflate readiness', () => {
+  const small = evaluateDiagnost(readySmall);
+  const large = evaluateDiagnost({ ...readySmall, team_size: 'large', sector: 'production' });
+  assert.deepEqual(small.scores, large.scores);
+  assert.equal(small.route, large.route);
+});
+
+test('connected data with paper task tracking creates a contradiction', () => {
+  const result = evaluateDiagnost({
+    ...readySmall,
+    process_data: 'connected',
+    task_tools: 'verbal_paper',
+  });
+  assert.equal(result.route, 'foundation');
+  assert.ok(result.contradictions.length > 0);
+  assert.match(result.contradictions[0], /Дані описані як системні/);
+});
+
+test('many unknown answers lead to discovery instead of a fabricated score', () => {
+  const result = evaluateDiagnost({
+    ...readySmall,
+    repeated_work: 'unknown',
