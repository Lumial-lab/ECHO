+function indicator(score, axis) {
+  if (score === null) {
+    return { axis, label: 'Недостатньо даних', tone: 'unknown', value: 0 };
+  }
+  if (score >= 3.1) return { axis, label: 'Сильна основа', tone: 'strong', value: score };
+  if (score >= 1.75) return { axis, label: 'Часткова готовність', tone: 'medium', value: score };
+  return { axis, label: 'Потрібна підготовка', tone: 'prepare', value: score };
+}
