+  if (['managed', 'connected'].includes(answers.process_data) && answers.task_tools === 'verbal_paper') {
+    contradictions.push('Дані описані як системні, але щоденна робота фіксується усно або на папері. Це потрібно уточнити до пілота.');
+  }
+  if (answers.process_visibility === 'measured' && ['verbal_paper', 'messages'].includes(answers.task_tools)) {
+    contradictions.push('Процес названо вимірюваним, але спосіб фіксації завдань не дає надійного джерела для цих вимірювань.');
+  }
